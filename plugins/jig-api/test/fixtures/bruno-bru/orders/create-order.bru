meta {
  name: Create order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/{{apiVersion}}/orders
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "customerId": "{{customerId}}",
    "sku": "{{sku}}",
    "quantity": {{quantity}},
    "createdAt": "{{$isoTimestamp}}"
  }
}

settings {
  encodeUrl: true
}
