@pageSize = {{nested.page.size}}

### Get order
# @name Get order
GET {{baseUrl}}/{{apiVersion}}/orders/{{orderId}}
Accept: application/json
Authorization: Bearer {{token}}

> {%
    client.test("it is there", function () {
        client.assert(response.status === 200);
    });
%}

###

// @name List orders
GET {{baseUrl}}/{{apiVersion}}/orders
    ?status={{status}}
    &limit={{pageSize}}
Authorization: Bearer {{token}}

### Create order
POST {{baseUrl}}/{{apiVersion}}/orders HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}
Idempotency-Key: {{$uuid}}

{
  "customerId": "{{customerId}}",
  "sku": "{{sku}}",
  "quantity": {{quantity}},
  "createdAt": "{{$isoTimestamp}}"
}

###
# @name Search orders
POST {{baseUrl}}/{{apiVersion}}/orders/search
Content-Type: application/json
Authorization: Bearer {{token}}

{"text": "{{text}}"}

###
DELETE {{baseUrl}}/{{apiVersion}}/orders/{{orderId}}
Authorization: Bearer {{token}}

### Basic status
GET {{baseUrl}}/status
Authorization: Basic {{serviceUser}} {{servicePassword}}

### Place order (form)
POST {{baseUrl}}/{{apiVersion}}/orders/form
Content-Type: application/x-www-form-urlencoded
Authorization: Bearer {{token}}

customer={{customerId}}
&note={{note}}

### Health
GET {{baseUrl}}/health
