        {
            "id": 8,
            "type": "table",
            "title": "Every call and turn, in order",
            "description": "A call row shows what was called, how it was decided and how it ended. A turn row is one model response, with its cost.",
            "datasource": {
                "type": "frser-sqlite-datasource",
                "uid": "jig-lens"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "frser-sqlite-datasource",
                        "uid": "jig-lens"
                    },
                    "queryType": "table",
                    "rawQueryText": "SELECT time,\n       'call' AS kind,\n       tool || coalesce(' ' || action, '') AS what,\n       environment,\n       decision,\n       decisionSource AS \"decided by\",\n       answer,\n       outcome,\n       errorKind,\n       durationMs AS duration,\n       waitedMs AS waited,\n       NULL AS cost,\n       error\nFROM call\nWHERE session = ${session:singlequote}\nUNION ALL\nSELECT time,\n       'turn',\n       model,\n       NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,\n       cost,\n       NULL\nFROM turn\nWHERE session = ${session:singlequote}\nORDER BY time, kind",
                    "queryText": "SELECT time,\n       'call' AS kind,\n       tool || coalesce(' ' || action, '') AS what,\n       environment,\n       decision,\n       decisionSource AS \"decided by\",\n       answer,\n       outcome,\n       errorKind,\n       durationMs AS duration,\n       waitedMs AS waited,\n       NULL AS cost,\n       error\nFROM call\nWHERE session = ${session:singlequote}\nUNION ALL\nSELECT time,\n       'turn',\n       model,\n       NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,\n       cost,\n       NULL\nFROM turn\nWHERE session = ${session:singlequote}\nORDER BY time, kind",
                    "timeColumns": ["time"]
                }
