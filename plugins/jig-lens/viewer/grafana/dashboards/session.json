    "templating": {
        "list": [
            {
                "name": "session",
                "label": "Session",
                "type": "query",
                "datasource": {
                    "type": "frser-sqlite-datasource",
                    "uid": "jig-lens"
                },
                "query": "SELECT strftime('%Y-%m-%d %H:%M', max(time), 'unixepoch') || '  ' || min(agentRole) || '  ' || substr(session, 1, 8) AS __text,\n       session AS __value\nFROM (SELECT session, agentRole, time FROM call UNION ALL SELECT session, agentRole, time FROM turn)\nGROUP BY session\nORDER BY max(time) DESC",
                "definition": "SELECT strftime('%Y-%m-%d %H:%M', max(time), 'unixepoch') || '  ' || min(agentRole) || '  ' || substr(session, 1, 8) AS __text,\n       session AS __value\nFROM (SELECT session, agentRole, time FROM call UNION ALL SELECT session, agentRole, time FROM turn)\nGROUP BY session\nORDER BY max(time) DESC",
                "refresh": 1,
                "sort": 0,
                "multi": false,
                "includeAll": false,
                "hide": 0,
                "options": [],
                "current": {}
