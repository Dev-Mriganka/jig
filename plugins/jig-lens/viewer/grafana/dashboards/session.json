        {
            "id": 6,
            "type": "table",
            "title": "This session",
            "description": "A child agent's session names the session that started it; click it to open that one.",
            "datasource": {
                "type": "frser-sqlite-datasource",
                "uid": "jig-lens"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "frser-sqlite-datasource",
                        "uid": "jig-lens"
                    },
                    "queryType": "table",
                    "rawQueryText": "SELECT min(agentRole) AS role,\n       max(ticket) AS ticket,\n       max(parentSession) AS \"parent session\",\n       min(time) AS started,\n       max(time) AS \"last record\"\nFROM (\n    SELECT agentRole, ticket, parentSession, time FROM call WHERE session = ${session:singlequote}\n    UNION ALL\n    SELECT agentRole, ticket, parentSession, time FROM turn WHERE session = ${session:singlequote}\n)",
                    "queryText": "SELECT min(agentRole) AS role,\n       max(ticket) AS ticket,\n       max(parentSession) AS \"parent session\",\n       min(time) AS started,\n       max(time) AS \"last record\"\nFROM (\n    SELECT agentRole, ticket, parentSession, time FROM call WHERE session = ${session:singlequote}\n    UNION ALL\n    SELECT agentRole, ticket, parentSession, time FROM turn WHERE session = ${session:singlequote}\n)",
                    "timeColumns": ["started", "last record"]
                }
            ],
