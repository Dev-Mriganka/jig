                    "queryType": "table",
                    "rawQueryText": "SELECT time,\n       session,\n       tool,\n       coalesce(action, '') AS action,\n       approval AS \"asked with\",\n       answer,\n       waitedMs AS waited\nFROM call\nWHERE answer IS NOT NULL AND time >= $__from / 1000 AND time < $__to / 1000\nORDER BY waitedMs DESC, time\nLIMIT 50",
                    "queryText": "SELECT time,\n       session,\n       tool,\n       coalesce(action, '') AS action,\n       approval AS \"asked with\",\n       answer,\n       waitedMs AS waited\nFROM call\nWHERE answer IS NOT NULL AND time >= $__from / 1000 AND time < $__to / 1000\nORDER BY waitedMs DESC, time\nLIMIT 50",
