                        "uid": "jig-lens"
                    },
                    "queryType": "time series",
                    "rawQueryText": "SELECT CAST(time / 86400 AS INTEGER) * 86400 AS day, count(*) AS questions\nFROM call\nWHERE answer IS NOT NULL AND time >= $__from / 1000 AND time < $__to / 1000\nGROUP BY day\nORDER BY day",
                    "queryText": "SELECT CAST(time / 86400 AS INTEGER) * 86400 AS day, count(*) AS questions\nFROM call\nWHERE answer IS NOT NULL AND time >= $__from / 1000 AND time < $__to / 1000\nGROUP BY day\nORDER BY day",
