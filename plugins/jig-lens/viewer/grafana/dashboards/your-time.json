        {
            "id": 6,
            "type": "table",
            "title": "Questions per tool",
            "description": "Each question is a call that asked. A tool that asks often is a candidate for a rule.",
            "datasource": {
                "type": "frser-sqlite-datasource",
                "uid": "jig-lens"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": {
                        "type": "frser-sqlite-datasource",
                        "uid": "jig-lens"
                    },
                    "queryType": "table",
                    "rawQueryText": "SELECT tool,\n       coalesce(action, '') AS action,\n       count(*) AS questions,\n       sum(answer = 'allow') AS allowed,\n       sum(answer = 'allow-session') AS \"allowed for the session\",\n       sum(answer = 'decline') AS declined,\n       sum(waitedMs) AS waited,\n       round(avg(waitedMs)) AS \"average wait\"\nFROM call\nWHERE answer IS NOT NULL AND time >= $__from / 1000 AND time < $__to / 1000\nGROUP BY tool, action\nORDER BY questions DESC, tool, action",
                    "queryText": "SELECT tool,\n       coalesce(action, '') AS action,\n       count(*) AS questions,\n       sum(answer = 'allow') AS allowed,\n       sum(answer = 'allow-session') AS \"allowed for the session\",\n       sum(answer = 'decline') AS declined,\n       sum(waitedMs) AS waited,\n       round(avg(waitedMs)) AS \"average wait\"\nFROM call\nWHERE answer IS NOT NULL AND time >= $__from / 1000 AND time < $__to / 1000\nGROUP BY tool, action\nORDER BY questions DESC, tool, action",
                    "timeColumns": []
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "auto",
                        "filterable": true,
                        "minWidth": 60
                    }
