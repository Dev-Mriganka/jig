                    "queryType": "table",
                    "rawQueryText": "SELECT time,\n       session,\n       tool,\n       coalesce(action, '') AS action,\n       errorKind,\n       error,\n       durationMs AS duration\nFROM call\nWHERE outcome = 'error' AND time >= $__from / 1000 AND time < $__to / 1000\nORDER BY time DESC\nLIMIT 100",
                    "queryText": "SELECT time,\n       session,\n       tool,\n       coalesce(action, '') AS action,\n       errorKind,\n       error,\n       durationMs AS duration\nFROM call\nWHERE outcome = 'error' AND time >= $__from / 1000 AND time < $__to / 1000\nORDER BY time DESC\nLIMIT 100",
                    "timeColumns": ["time"]
