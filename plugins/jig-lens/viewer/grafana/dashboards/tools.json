                                "value": 290
                            },
                            {
                                "id": "links",
                                "value": [
                                    {
                                        "title": "Open this session",
                                        "url": "/d/jig-session?var-session=${__value.raw}"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "footer": {
                    "show": false
                }
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 17
            }
        },
        {
            "id": 6,
            "type": "table",
            "title": "Recent failures",
            "description": "Calls whose tool ran and failed, or that never reached it. Click a session to see the calls around it.",
            "datasource": {
