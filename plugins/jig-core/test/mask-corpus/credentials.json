            "input": {
                "password": "FAKE-Password-Only-001!",
                "pin": "0000",
                "orderId": "ord-7901"
            },
            "must_not_contain": ["FAKE-Password-Only-001!", "0000"],
            "must_keep": ["ord-7901"],
            "expect_tags": [],
            "notes": "Explicitly fake password and PIN."
        },
        {
            "id": "cred-porting-account-pin",
            "input": {
                "portingPin": "2468",
                "accountPIN": "1357",
                "accountId": "acct-demo-902"
            },
            "must_not_contain": ["2468", "1357"],
            "must_keep": ["acct-demo-902"],
            "expect_tags": [],
            "notes": "Porting and account PIN fields."
        },
        {
            "id": "cred-api-token",
            "input": {
                "apiToken": "tok_FAKE_TEST_ONLY_001abcdef",
                "orderId": "ord-7903"
            },
            "must_not_contain": ["tok_FAKE_TEST_ONLY_001abcdef"],
            "must_keep": ["ord-7903"],
            "expect_tags": [],
            "notes": "Obvious synthetic API token."
        },
        {
            "id": "cred-jwt",
            "input": {
                "authorization": "Bearer eyJhbGciOiJub25lIn0.eyJzdWIiOiJleGFtcGxlIn0.ZmFrZS1zaWduYXR1cmU",
                "traceId": "trace-7904"
            },
            "must_not_contain": ["eyJhbGciOiJub25lIn0.eyJzdWIiOiJleGFtcGxlIn0.ZmFrZS1zaWduYXR1cmU"],
            "must_keep": ["trace-7904"],
            "expect_tags": [],
            "notes": "JWT-shaped fake value with an alg none header and a fake signature."
        },
        {
            "id": "cred-sip-secret",
            "input": {
                "sip": {
                    "authSecret": "FAKE-SIP-SECRET-005",
                    "username": "sip_demo_905"
                },
                "orderId": "ord-7905"
            },
            "must_not_contain": ["FAKE-SIP-SECRET-005", "sip_demo_905"],
            "must_keep": ["ord-7905"],
            "expect_tags": ["user"],
            "notes": "SIP secret is removed and SIP username is tokenized."
        },
        {
            "id": "cred-security-answer",
            "input": {
                "securityAnswer": "FAKE-ANSWER-BLUE",
                "status": "ACTIVE"
            },
            "must_not_contain": ["FAKE-ANSWER-BLUE"],
            "must_keep": ["ACTIVE"],
            "expect_tags": [],
            "notes": "Security answers are credentials."
        },
        {
            "id": "cred-url-query-and-log",
            "input": "GET /auth?api_token=tok_FAKE_TEST_ONLY_007abcdef&orderId=ord-7907",
            "must_not_contain": ["tok_FAKE_TEST_ONLY_007abcdef"],
            "must_keep": ["ord-7907"],
            "expect_tags": [],
            "notes": "API token inside a URL query."
        },
        {
            "id": "cred-negative-controls",
            "input": {
                "orderId": "PIN-7908",
                "sku": "TOKEN-BOARD-8",
