{
  "size": 0,
  "timeout": "25s",
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2026-10-13T10:00:00Z",
              "lt": "2026-10-13T12:00:00Z",
              "format": "strict_date_optional_time"
            }
          }
        },
        {
          "term": {
            "env.keyword": "prod"
          }
        },
        {
          "term": {
            "tier.keyword": "web"
          }
        },
        {
          "term": {
            "region_code": 7
          }
        },
        {
          "term": {
            "canary": false
          }
        },
        {
          "terms": {
            "namespace.keyword": [
              "orders",
              "billing"
            ]
          }
        }
      ]
    }
  }
}
