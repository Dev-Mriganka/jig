{
    "name": "jig",
    "version": "0.1.0",
    "private": true,
    "description": "One tool manager and a set of plugins for the Pi coding agent: permissions per tool and environment, approvals, secrets and records.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "pi-package"
    ],
    "scripts": {
        "test": "node --import ./test/support/host.mjs --test \"plugins/*/test/*.test.ts\"",
        "check": "node test/support/link-host.mjs && tsc -p tsconfig.json && biome ci .",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check:web": "npm --prefix plugins/jig-review/web run check",
        "test:web": "npm --prefix plugins/jig-review/web test",
        "check:dist": "node test/support/check-web-dist.mjs"
    },
    "dependencies": {
        "@hono/node-server": "2.1.3",
        "hono": "4.13.11",
        "ignore": "7.0.10",
        "mongodb": "7.7.0",
        "yaml": "2.9.1"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "pi": {
        "extensions": [
            "./plugins/jig-core/src/index.ts",
            "./plugins/jig-memory/src/index.ts",
            "./plugins/jig-git/src/index.ts",
            "./plugins/jig-lens/src/index.ts",
            "./plugins/jig-jira/src/index.ts",
            "./plugins/jig-logs/src/index.ts",
            "./plugins/jig-api/src/index.ts",
            "./plugins/jig-ops/src/index.ts",
            "./plugins/jig-review/src/index.ts",
            "./plugins/jig-mongo/src/index.ts"
        ],
        "skills": [
            "./plugins/*/skills"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "typescript": "5.9.3"
    }
}
