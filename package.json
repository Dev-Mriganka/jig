{
    "name": "jig",
    "version": "0.1.0",
    "private": true,
    "description": "One tool manager and a set of plugins for the Pi coding agent: permissions per tool and environment, approvals, secrets and records.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "pi-package"
    ],
    "scripts": {
        "test": "node --import ./test/support/host.mjs --test \"plugins/*/test/*.test.ts\" \"examples/*/test/*.test.ts\"",
        "test:it": "node --import ./test/support/host.mjs --test \"plugins/*/test/it/*.test.ts\"",
        "check": "node test/support/link-host.mjs && node scripts/check-pinned-deps.mjs && node scripts/check-runtime-deps.mjs && tsc -p tsconfig.json && biome ci .",
        "check:install": "node scripts/check-install.mjs",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check:web": "npm --prefix plugins/jig-review/web run check",
        "test:web": "npm --prefix plugins/jig-review/web test",
        "check:dist": "node test/support/check-web-dist.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sandbox-runtime": "0.0.81",
        "@hono/node-server": "2.1.5",
        "hono": "4.13.14",
        "ignore": "7.0.14",
        "mongodb": "7.8.0",
        "socks": "2.8.10",
        "yaml": "2.9.1"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "pi": {
        "extensions": [
            "./plugins/jig-core/src/index.ts",
            "./plugins/jig-sandbox/src/index.ts",
            "./plugins/jig-memory/src/index.ts",
            "./plugins/jig-workflow/src/index.ts",
            "./plugins/jig-agents/src/index.ts",
            "./plugins/jig-git/src/index.ts",
            "./plugins/jig-lens/src/index.ts",
            "./plugins/jig-jira/src/index.ts",
            "./plugins/jig-logs/src/index.ts",
            "./plugins/jig-api/src/index.ts",
            "./plugins/jig-ops/src/index.ts",
            "./plugins/jig-review/src/index.ts",
            "./plugins/jig-mongo/src/index.ts",
            "./plugins/jig-theme/src/index.ts"
        ],
        "skills": [
            "./plugins/*/skills"
        ],
        "themes": [
            "./plugins/jig-theme/themes/*.json"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "typescript": "7.0.2"
    }
}
