{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!plugins/jig-review/web",
            "!plugins/jig-logs/test/golden",
            "!plugins/jig-theme/themes",
            "!package-lock.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
    },
    "markdown": { "formatter": { "enabled": false } },
    "yaml": { "formatter": { "enabled": false } },
    "assist": { "enabled": false },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 40 } }
            },
            "style": { "noNonNullAssertion": "off" },
            "suspicious": { "noControlCharactersInRegex": "off" }
        }
    },
    "overrides": [
        {
            "includes": ["plugins/*/test/**", "examples/*/test/**", "test/**"],
            "linter": {
                "rules": {
                    "suspicious": { "noExplicitAny": "off", "noAssignInExpressions": "off" },
                    "complexity": {
                        "noCommaOperator": "off",
                        "noAdjacentSpacesInRegex": "off",
                        "noExcessiveCognitiveComplexity": "off"
                    }
                }
            }
        }
    ]
}
