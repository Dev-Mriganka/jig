{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": ["**", "!**/node_modules", "!plugins/jig-review/web", "!package-lock.json"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
    },
    "assist": { "enabled": false },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": { "noNonNullAssertion": "off" },
            "suspicious": { "noControlCharactersInRegex": "off" }
        }
    },
    "overrides": [
        {
            "includes": ["plugins/*/test/**", "test/**"],
            "linter": {
                "rules": {
                    "suspicious": { "noExplicitAny": "off", "noAssignInExpressions": "off" },
                    "complexity": { "noCommaOperator": "off", "noAdjacentSpacesInRegex": "off" }
                }
            }
        }
    ]
}
