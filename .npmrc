# Pi supplies its own packages to extensions, so none is installed as a peer (what Pi's own install of a git package does too).
legacy-peer-deps=true
# `npm install <package>` writes an exact version (AGENTS.md, "Dependencies"; scripts/check-pinned-deps.mjs checks it).
save-exact=true
# A version that is younger than this many days is not picked when npm resolves a new one, so a release that is pulled or found to be
# malicious within two days is never installed by `npm install <package>`. A lockfile is installed as it is. npm before 11.10 does not
# know the setting and warns about it. Dependabot waits 3 days (.github/dependabot.yml).
min-release-age=2
